# Copy this file to ".env" and fill in your own values.
# .env holds SECRETS only - never put passwords/tokens in config.json, and never commit .env.

# --- Gmail sending (optional) -----------------------------------------------
# Use a Gmail "App Password", NOT your normal account password.
# Requires 2-Step Verification: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# --- Telegram (used by BOTH the script and the bot) -------------------------
# Create a bot with @BotFather and paste its token. Leave blank to disable Telegram in the script.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample
# Only needed if Telegram is blocked in your country: your Cloudflare Worker that proxies
# api.telegram.org. Leave it out to talk to Telegram directly.
CLOUDFLARE_WORKER_URL=https://your-worker.example.workers.dev

# --- WhatsApp via Green API (optional) ---------------------------------------
GREEN_API_INSTANCE_ID=1101000000
GREEN_API_TOKEN=exampletokenexampletokenexampletoken
# GREEN_API_URL=https://api.green-api.com

# --- Admin alerts from the script (optional) ----------------------------------
# Told when a bill cannot be fetched, or when the FESCO site layout seems to have changed.
ADMIN_ALERT_EMAIL=admin@example.com
ADMIN_ALERT_TELEGRAM_CHAT_ID=111111111

# --- Telegram bot (bot_listener.py) ------------------------------------------
# Admins: full access to every command, no limits. The FIRST id also receives
# notices, the "bot is online" message and health alerts. Find your id with @userinfobot.
ALLOWED_USER_ID=111111111,222222222
# Extra people fixed in .env (optional - you can also manage people from Telegram with /adduser):
RUN_USER_IDS=
GETBILLBYREF_USER_IDS=
# Full path to the automation script the bot starts:
PLAYWRIGHT_SCRIPT_PATH=C:\Users\you\fesco\fesco_bill_automation.py


