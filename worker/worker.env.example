# ─────────────────────────────────────────────────────
# worker.env  —  copy to worker.env and fill in
# ─────────────────────────────────────────────────────

# Azure Storage connection string
# Get from: Azure Portal → Storage Account → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net

# Unique name for THIS PC — used in /workers command on Telegram
WORKER_NAME=PC-Office

# ── Optional ──────────────────────────────────────────

# Seconds to wait after boot before starting (default 120)
STARTUP_DELAY=120

# Seconds between queue polls when idle (default 15)
POLL_INTERVAL=15

# Heartbeat interval in seconds (default 30)
HEARTBEAT_INTERVAL=30

# Kill the automation script after this many seconds (default 3600)
JOB_TIMEOUT=3600

# How long a claimed job stays invisible to other workers in seconds (default 600 = 10 min)
# Set this higher than your longest expected job duration
VISIBILITY_TIMEOUT=600

# Path to fesco_bill_automation.py if non-standard
# AUTOMATION_SCRIPT=C:\Users\RJM\Documents\fescobill\src\fesco_bill_automation.py
